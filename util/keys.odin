package util

KEY_BACKSPACE :: cast(u32)0x08
KEY_TAB       :: cast(u32)0x09
KEY_RETURN    :: cast(u32)0x0d
KEY_ESCAPE    :: cast(u32)0x1b
KEY_SPACE     :: cast(u32)0x20
KEY_PAGE_UP   :: cast(u32)0x21
KEY_PAGE_DOWN :: cast(u32)0x22
KEY_END       :: cast(u32)0x23
KEY_HOME      :: cast(u32)0x24
KEY_LEFT      :: cast(u32)0x25
KEY_UP        :: cast(u32)0x26
KEY_RIGHT     :: cast(u32)0x27
KEY_DOWN      :: cast(u32)0x28

